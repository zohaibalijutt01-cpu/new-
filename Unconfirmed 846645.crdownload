/* animations.js — add <script src="animations.js"></script> just before </body> */
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var css = `
html.js-anim .rv{opacity:0}
html.js-anim .rv.in{animation:rvUp .8s cubic-bezier(.2,.7,.2,1) var(--d,0s) both}
@keyframes rvUp{from{opacity:0;transform:translateY(34px) scale(.98)}to{opacity:1;transform:none}}
html.js-anim .bubble.rv.in{animation:bubIn .5s cubic-bezier(.2,.9,.3,1.3) var(--d,0s) both}
@keyframes bubIn{from{opacity:0;transform:translateY(14px) scale(.9)}to{opacity:1;transform:none}}

html.js-anim .hl,html.js-anim .hl2{background-repeat:no-repeat;background-size:0% 100%;transition:background-size .9s cubic-bezier(.7,0,.2,1) .35s}
html.js-anim .hl.on,html.js-anim .hl2.on{background-size:100% 100%}

.hero .wrap{position:relative;z-index:1}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;z-index:0;pointer-events:none}
.blob.b1{width:380px;height:380px;background:var(--lime);top:-80px;left:-90px;animation:drift 14s ease-in-out infinite alternate}
.blob.b2{width:320px;height:320px;background:#9be3c4;top:120px;right:-80px;animation:drift 17s ease-in-out infinite alternate-reverse}
@keyframes drift{to{transform:translate(70px,50px) scale(1.15)}}

#scroll-bar{position:fixed;top:0;left:0;height:3px;width:100%;background:linear-gradient(90deg,var(--green2),var(--lime));transform-origin:0 50%;transform:scaleX(0);z-index:60}
nav{transition:box-shadow .3s}
nav.scrolled{box-shadow:0 8px 30px rgba(0,0,0,.08)}

.btn{position:relative;overflow:hidden}
.btn::after{content:"";position:absolute;top:0;left:-75%;width:50%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);pointer-events:none}
.btn:hover::after{animation:shine .7s}
@keyframes shine{to{left:130%}}

.step .art{background-size:200% 200%;animation:grad 8s ease infinite}
@keyframes grad{50%{background-position:100% 100%}}
.bob{display:inline-block;animation:bob 3s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-12px) rotate(4deg)}}

#chat-fab{transition:transform .2s}
#chat-fab:hover{transform:scale(1.1) rotate(-8deg)}
#chat-fab::after{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid #131313;animation:ring 2.4s ease-out infinite;pointer-events:none}
@keyframes ring{from{transform:scale(1);opacity:.6}to{transform:scale(1.7);opacity:0}}
#chat-panel.open{transform-origin:bottom right;animation:panelIn .38s cubic-bezier(.2,.9,.3,1.15)}
@keyframes panelIn{from{opacity:0;transform:translateY(20px) scale(.85)}to{opacity:1;transform:none}}
.typing{animation:blink 1s infinite}
@keyframes blink{50%{opacity:.35}}
`;

  var st = document.createElement('style');
  st.textContent = css;
  document.head.appendChild(st);
  document.documentElement.classList.add('js-anim');

  /* ---------- count-up for numeric stats (skips placeholders like [X]+ and 24/7) ---------- */
  function count(n) {
    if (!n) return;
    var m = n.textContent.trim().match(/^(\d+)(.*)$/);
    if (!m || m[2].indexOf('/') > -1) return;
    var end = +m[1], tail = m[2], t0 = null;
    function f(t) {
      if (!t0) t0 = t;
      var p = Math.min((t - t0) / 1400, 1);
      n.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))) + tail;
      if (p < 1) requestAnimationFrame(f);
    }
    requestAnimationFrame(f);
  }

  /* ---------- scroll reveal ---------- */
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      var el = e.target;
      io.unobserve(el);
      el.classList.add('in');
      el.addEventListener('animationend', function done(ev) {
        if (ev.target !== el) return;
        el.classList.remove('rv', 'in');
        el.removeEventListener('animationend', done);
      });
      if (el.classList.contains('stat')) count(el.querySelector('.num'));
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  var sel = '.hero h1,.hero p.sub,.hero-cta,.hero .micro,.hero-visual,.logos p,.logo-row span,.stat,.kicker,h2,.sub,.card,.step,.cta-band,#contact-form form,.info-row,footer .wrap>div';
  document.querySelectorAll(sel).forEach(function (el) {
    var sibs = Array.prototype.filter.call(el.parentNode.children, function (c) { return c.matches(sel); });
    var d = Math.min(sibs.indexOf(el) * 0.12, 0.6);
    el.style.setProperty('--d', d + 's');
    el.classList.add('rv');
    io.observe(el);
  });

  /* hero chat bubbles pop in one after another */
  document.querySelectorAll('.hv-body .bubble').forEach(function (b, i) {
    b.style.setProperty('--d', (0.8 + i * 0.9) + 's');
    b.classList.add('rv');
    io.observe(b);
  });

  /* ---------- highlighter sweep ---------- */
  var ioH = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('on'); ioH.unobserve(e.target); }
    });
  }, { threshold: 0.6 });
  document.querySelectorAll('.hl,.hl2').forEach(function (el) { ioH.observe(el); });

  /* ---------- floating blobs behind hero ---------- */
  var hero = document.querySelector('.hero');
  if (hero) {
    ['b1', 'b2'].forEach(function (c) {
      var d = document.createElement('div');
      d.className = 'blob ' + c;
      hero.insertBefore(d, hero.firstChild);
    });
  }

  /* ---------- bobbing emoji in "How it works" ---------- */
  document.querySelectorAll('.step .art').forEach(function (a) {
    a.innerHTML = '<span class="bob">' + a.textContent + '</span>';
  });

  /* ---------- scroll progress bar + nav shadow ---------- */
  var bar = document.createElement('div');
  bar.id = 'scroll-bar';
  document.body.appendChild(bar);
  var nav = document.querySelector('nav'), tick = false;
  function onScroll() {
    if (tick) return;
    tick = true;
    requestAnimationFrame(function () {
      var h = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = 'scaleX(' + (h > 0 ? scrollY / h : 0) + ')';
      if (nav) nav.classList.toggle('scrolled', scrollY > 10);
      tick = false;
    });
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
